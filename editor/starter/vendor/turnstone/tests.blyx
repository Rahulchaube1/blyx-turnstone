use std::cli;
use turnstone;

fn matches(actual: vector, expected: vector) -> bool {
    if len(actual) != len(expected) { return false; }
    let mut i = 0;
    while i < len(expected) {
        let delta = at(actual, i) - at(expected, i);
        let limit = 0.000000001 + 0.000000001 * at(expected, i) * at(expected, i) / (1.0 + at(expected, i) * at(expected, i));
        if !(delta >= -limit && delta <= limit) { return false; }
        i += 1;
    }
    true
}

fn main() {
    let infinity = 1.0e300 * 1.0e300;
    if !matches(turnstone_resume(10.0, 4.0, [0, 0, 1]), [8, 2, 1, 1]) { stderr_line("case 1 failed"); process_exit(1); }
    if !matches(turnstone_resume(10.0, 4.0, [0, 1, 2]), [10, 0, 0, 0]) { stderr_line("case 2 failed"); process_exit(1); }
    if !matches(turnstone_resume(0.0, 1.0, []), [0, 0, 0, 0]) { stderr_line("case 3 failed"); process_exit(1); }
    if !matches(turnstone_resume(10.0, 4.0, [1]), []) { stderr_line("case 4 failed"); process_exit(1); }
    if !matches(turnstone_resume(infinity, 4.0, [0, 0, 1]), []) { stderr_line("case 5 failed"); process_exit(1); }
    if !matches(turnstone_resume(10.0, infinity, [0, 0, 1]), []) { stderr_line("case 6 failed"); process_exit(1); }
    if !matches(turnstone_resume(10.0, 4.0, [infinity]), []) { stderr_line("case 7 failed"); process_exit(1); }
    println!("passed");
}
