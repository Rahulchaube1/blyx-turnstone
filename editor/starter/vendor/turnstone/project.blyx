use std::cli;
use console;
use turnstone;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Resume a chunked file job from acknowledged checkpoints.");
        println!("Usage: turnstone size width checkpoints");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = turnstone_resume(10.0, 4.0, [0, 0, 1]);
    } else {
        if count != 3 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let size = console_value(args_at(argv, 0));
        let width = console_value(args_at(argv, 1));
        let checkpoints = console_vector(args_at(argv, 2));
        result = turnstone_resume(size, width, checkpoints);
    }
    if len(result) == 0 { stderr_line("Invalid input for Turnstone. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
